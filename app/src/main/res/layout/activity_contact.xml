<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main.contactUs.ContactActivity">

    <ImageView
        android:id="@id/imageView22"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:alpha="0.1"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/backgroud_pipe" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/constraintLayout"
        android:layout_width="fill_parent"
        android:layout_height="75.0dip"
        android:background="#ff2d2f93"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@id/back"
            android:layout_width="23.0dip"
            android:layout_height="32.0dip"
            android:layout_marginStart="10.0dip"
            android:padding="7.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/back" />

        <TextView
            android:id="@id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Contact Us"
            android:textColor="@color/white"
            android:textSize="16.0sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@id/logo"
        android:layout_width="100.0dip"
        android:layout_height="100.0dip"
        android:layout_marginTop="50.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <ScrollView
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginTop="20.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20.0dip"
                android:layout_marginTop="25.0dip"
                android:layout_marginEnd="20.0dip"
                android:layout_marginBottom="20.0dip"
                app:cardCornerRadius="10.0dip"
                app:cardElevation="3.0dip">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="25.0dip"
                    android:orientation="vertical">

                    <TextView
                        android:id="@id/textView8"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Get in touch"
                        android:textColor="#ff444444"
                        android:textSize="18.0sp" />

                    <TextView
                        android:id="@id/textView9"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="#ff444444"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@id/llName"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip"
                        android:layout_marginTop="11.0dip"
                        android:background="@drawable/edittext_bg"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@id/imageView16"
                            android:layout_width="16.0dip"
                            android:layout_height="16.0dip"
                            android:layout_marginStart="12.0dip"
                            app:srcCompat="@drawable/user" />

                        <EditText
                            android:id="@id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:layout_marginStart="10.0dip"
                            android:layout_marginEnd="10.0dip"
                            android:layout_weight="1.0"
                            android:background="@android:color/transparent"
                            android:ems="10"
                            android:fontFamily="@font/poppins_regular"
                            android:hint="Name"
                            android:inputType="textPersonName"
                            android:textColor="#ff444444"
                            android:textSize="14.0sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@id/llEmail"
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip"
                        android:layout_marginTop="11.0dip"
                        android:background="@drawable/edittext_bg"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@id/imageView17"
                            android:layout_width="16.0dip"
                            android:layout_height="16.0dip"
                            android:layout_marginStart="12.0dip"
                            app:srcCompat="@drawable/email" />

                        <EditText
                            android:id="@id/email"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:layout_marginStart="10.0dip"
                            android:layout_marginEnd="10.0dip"
                            android:layout_weight="1.0"
                            android:background="@android:color/transparent"
                            android:ems="10"
                            android:fontFamily="@font/poppins_regular"
                            android:hint="Email ID"
                            android:inputType="textEmailAddress"
                            android:textColor="#ff444444"
                            android:textSize="14.0sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@id/llMessage"
                        android:layout_width="fill_parent"
                        android:layout_height="150.0dip"
                        android:layout_marginTop="11.0dip"
                        android:background="@drawable/edittext_bg"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@id/imageView18"
                            android:layout_width="16.0dip"
                            android:layout_height="16.0dip"
                            android:layout_marginStart="12.0dip"
                            android:layout_marginTop="15.0dip"
                            app:srcCompat="@drawable/email" />

                        <EditText
                            android:id="@id/message"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:layout_marginStart="10.0dip"
                            android:layout_marginTop="15.0dip"
                            android:layout_marginEnd="10.0dip"
                            android:layout_marginBottom="15.0dip"
                            android:layout_weight="1.0"
                            android:background="@android:color/transparent"
                            android:ems="10"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start|top"
                            android:hint="Message"
                            android:inputType="textMultiLine"
                            android:textColor="#ff444444"
                            android:textSize="14.0sp" />
                    </LinearLayout>

                    <Button
                        android:id="@id/send"
                        android:layout_width="170.0dip"
                        android:layout_height="45.0dip"
                        android:layout_gravity="center"
                        android:layout_marginTop="22.0dip"
                        android:layout_marginBottom="22.0dip"
                        android:backgroundTint="#ff2d2f93"
                        android:fontFamily="@font/poppins_regular"
                        android:insetTop="0.0dip"
                        android:insetBottom="0.0dip"
                        android:text="Send"
                        android:textAllCaps="false"
                        android:textSize="16.0sp"
                        app:cornerRadius="5.0dip" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginStart="20.0dip"
                android:layout_marginEnd="20.0dip"
                android:layout_marginBottom="30.0dip"
                app:cardBackgroundColor="#ff3f42c0"
                app:cardCornerRadius="13.0dip">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25.0dip"
                    android:layout_marginTop="20.0dip"
                    android:layout_marginEnd="25.0dip"
                    android:layout_marginBottom="20.0dip"
                    android:orientation="vertical">

                    <TextView
                        android:id="@id/textView10"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Contact Details"
                        android:textColor="@color/white"
                        android:textSize="18.0sp" />

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@id/imageView19"
                            android:layout_width="35.0dip"
                            android:layout_height="35.0dip"
                            app:srcCompat="@drawable/contact_phone" />

                        <TextView
                            android:id="@id/phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13.0dip"
                            android:layout_weight="1.0"
                            android:fontFamily="@font/poppins_regular"
                            android:text="620.271.0037"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@id/imageView20"
                            android:layout_width="35.0dip"
                            android:layout_height="35.0dip"
                            app:srcCompat="@drawable/contact_email" />

                        <TextView
                            android:id="@id/tvemail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13.0dip"
                            android:layout_weight="1.0"
                            android:fontFamily="@font/poppins_regular"
                            android:text="gcap@ammoniatraining.com"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@id/imageView21"
                            android:layout_width="35.0dip"
                            android:layout_height="35.0dip"
                            app:srcCompat="@drawable/contact_address" />

                        <TextView
                            android:id="@id/address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13.0dip"
                            android:layout_weight="1.0"
                            android:fontFamily="@font/poppins_regular"
                            android:text="2405 East Fulton - Garden City, KS"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@id/imageView211"
                            android:layout_width="35.0dip"
                            android:layout_height="35.0dip"
                            app:srcCompat="@drawable/contact_website" />

                        <TextView
                            android:id="@id/website"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13.0dip"
                            android:layout_weight="1.0"
                            android:fontFamily="@font/poppins_regular"
                            android:text="2405 East Fulton - Garden City, KS"
                            android:textColor="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/loading_overlay" />
</androidx.constraintlayout.widget.ConstraintLayout>