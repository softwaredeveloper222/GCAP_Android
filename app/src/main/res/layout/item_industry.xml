<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="180.0dip">

    <androidx.cardview.widget.CardView
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginBottom="25.0dip"
        app:cardCornerRadius="10.0dip"
        app:cardElevation="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">

            <ImageView
                android:id="@+id/ivIndustry"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@id/view2"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:background="@drawable/gradient"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@id/imageView29"
                android:layout_width="22.0dip"
                android:layout_height="22.0dip"
                android:layout_marginEnd="17.0dip"
                app:layout_constraintBottom_toBottomOf="@id/view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/view"
                app:srcCompat="@drawable/right_circle" />

            <TextView
                android:id="@+id/tvIndustry"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginStart="6.0dip"
                android:layout_marginEnd="6.0dip"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:text="TextView"
                android:textColor="@color/white"
                android:textSize="18.0sp"
                app:layout_constraintBottom_toBottomOf="@id/view"
                app:layout_constraintEnd_toStartOf="@id/imageView29"
                app:layout_constraintStart_toEndOf="@id/view"
                app:layout_constraintTop_toTopOf="@id/view" />

            <View
                android:id="@id/view"
                android:layout_width="4.0dip"
                android:layout_height="22.0dip"
                android:layout_marginStart="10.0dip"
                android:layout_marginBottom="19.0dip"
                android:background="#ff90cff2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
