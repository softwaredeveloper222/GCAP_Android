<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main.magneticTool.MagneticActivity">
    <ImageView
        android:id="@id/imageView35"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:alpha="0.1"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/backgroud_pipe" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/constraintLayout"
        android:layout_width="fill_parent"
        android:layout_height="75.0dip"
        android:background="#ff2d2f93"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@id/back"
            android:layout_width="23.0dip"
            android:layout_height="32.0dip"
            android:layout_marginStart="10.0dip"
            android:padding="7.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/back" />

        <TextView
            android:id="@id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Magnetic Tool"
            android:textColor="@color/white"
            android:textSize="16.0sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@id/logo"
        android:layout_width="100.0dip"
        android:layout_height="100.0dip"
        android:layout_marginTop="50.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <androidx.cardview.widget.CardView
        android:id="@id/cardView7"
        android:layout_width="fill_parent"
        android:layout_height="70.0dip"
        android:layout_marginStart="20.0dip"
        android:layout_marginEnd="20.0dip"
        android:layout_marginBottom="20.0dip"
        app:cardBackgroundColor="#ffe5e5e5"
        app:cardCornerRadius="10.0dip"
        app:cardElevation="1.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="20.0dip"
            android:paddingEnd="20.0dip">

            <TextView
                android:id="@id/textView30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:fontFamily="@font/poppins_regular"
                android:text="Advanced options"
                android:textColor="#ff444444"
                android:textSize="15.0sp" />

            <com.suke.widget.SwitchButton
                android:id="@id/switch_advance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="16.0dip"
                app:layout_constraintEnd_toEndOf="@id/textView13"
                app:layout_constraintTop_toTopOf="@id/textView12"
                app:sb_button_color="#ff2d2f93"
                app:sb_checked="false"
                app:sb_checked_color="#ff90cff2"
                app:sb_show_indicator="false" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginTop="20.0dip"
        android:layout_marginBottom="20.0dip"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/cardView7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">

            <androidx.cardview.widget.CardView
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:layout_marginStart="20.0dip"
                android:layout_marginTop="8.0dip"
                android:layout_marginEnd="20.0dip"
                android:layout_marginBottom="7.0dip"
                app:cardCornerRadius="10.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">

                    <ImageView
                        android:id="@id/circle"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        android:layout_marginStart="80.0dip"
                        android:layout_marginEnd="80.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="w,1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/circle" />

                    <ImageView
                        android:id="@+id/volume"
                        android:layout_width="40.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20.0dip"
                        android:layout_marginBottom="10.0dip"
                        android:adjustViewBounds="true"
                        android:padding="10.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:srcCompat="@drawable/volume_on" />

                    <TextView
                        android:id="@id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Normal EMF detected"
                        android:textColor="#ff444444"
                        android:textSize="17.0sp"
                        app:layout_constraintBottom_toBottomOf="@id/volume"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/volume" />

                    <ImageView
                        android:id="@id/vibrate"
                        android:layout_width="40.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20.0dip"
                        android:layout_marginBottom="10.0dip"
                        android:adjustViewBounds="true"
                        android:padding="10.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:srcCompat="@drawable/vibrate_on" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clAdvanced"
            android:layout_width="fill_parent"
            android:layout_height="135.0dip"
            android:layout_marginTop="20.0dip"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="fill_parent"
                android:layout_height="50.0dip"
                android:layout_marginStart="20.0dip"
                android:layout_marginEnd="20.0dip"
                android:layout_marginBottom="7.0dip"
                app:cardCornerRadius="10.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:id="@id/llActivate"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@id/ivActivate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/pause" />

                    <TextView
                        android:id="@id/tvActivate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15.0dip"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Deactivate"
                        android:textSize="15.0sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@id/cardView8"
                android:layout_width="fill_parent"
                android:layout_height="60.0dip"
                android:layout_marginStart="20.0dip"
                android:layout_marginTop="7.0dip"
                android:layout_marginEnd="20.0dip"
                app:cardCornerRadius="10.0dip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@id/llThreshold"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@id/tvCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="DC"
                        android:textColor="#ff444444"
                        android:textSize="17.0sp" />

                    <TextView
                        android:id="@id/tvThreshold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Threshold: 400 µT"
                        android:textColor="#ff444444"
                        android:textSize="15.0sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@id/tvInstruction"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20.0dip"
            android:layout_marginTop="15.0dip"
            android:layout_marginEnd="20.0dip"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="the indicator rotates when a high eletromagnetic field is detected"
            android:textSize="15.0sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>