<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main.calculators.CalculatorsActivity">

    <ImageView
        android:id="@id/imageView28"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:alpha="0.1"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/backgroud_pipe" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/constraintLayout"
        android:layout_width="fill_parent"
        android:layout_height="75.0dip"
        android:background="#ff2d2f93"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@id/back"
            android:layout_width="23.0dip"
            android:layout_height="32.0dip"
            android:layout_marginStart="10.0dip"
            android:padding="7.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/back" />

        <TextView
            android:id="@id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Calculators"
            android:textColor="@color/white"
            android:textSize="16.0sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@id/logo"
        android:layout_width="100.0dip"
        android:layout_height="100.0dip"
        android:layout_marginTop="50.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <ScrollView
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="20.0dip"
        android:layout_marginTop="20.0dip"
        android:layout_marginEnd="20.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@id/cv1"
                android:layout_width="fill_parent"
                android:layout_height="100.0dip"
                android:layout_marginBottom="15.0dip"
                app:cardCornerRadius="10.0dip">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@id/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24.0dip"
                        android:layout_marginEnd="30.0dip"
                        android:layout_weight="1.0"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Saturation Calculator (Input: PSIG)"
                        android:textColor="#ff444444"
                        android:textSize="16.0sp" />

                    <ImageView
                        android:id="@id/imageView9"
                        android:layout_width="9.0dip"
                        android:layout_height="16.0dip"
                        android:layout_marginEnd="13.0dip"
                        app:srcCompat="@drawable/right_arrow" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@id/cv2"
                android:layout_width="fill_parent"
                android:layout_height="100.0dip"
                android:layout_marginBottom="15.0dip"
                app:cardCornerRadius="10.0dip">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24.0dip"
                        android:layout_marginEnd="30.0dip"
                        android:layout_weight="1.0"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Saturation Calculator (Input: PSIA)"
                        android:textColor="#ff444444"
                        android:textSize="16.0sp" />

                    <ImageView
                        android:id="@id/imageView10"
                        android:layout_width="9.0dip"
                        android:layout_height="16.0dip"
                        android:layout_marginEnd="13.0dip"
                        app:srcCompat="@drawable/right_arrow" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@id/cv3"
                android:layout_width="fill_parent"
                android:layout_height="100.0dip"
                android:layout_marginBottom="15.0dip"
                app:cardCornerRadius="10.0dip">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@id/textView3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24.0dip"
                        android:layout_marginEnd="30.0dip"
                        android:layout_weight="1.0"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Saturation Calculator (Input: °F)"
                        android:textColor="#ff444444"
                        android:textSize="16.0sp" />

                    <ImageView
                        android:id="@id/imageView11"
                        android:layout_width="9.0dip"
                        android:layout_height="16.0dip"
                        android:layout_marginEnd="13.0dip"
                        app:srcCompat="@drawable/right_arrow" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@id/cv4"
                android:layout_width="fill_parent"
                android:layout_height="100.0dip"
                android:layout_marginBottom="15.0dip"
                app:cardCornerRadius="10.0dip">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@id/textView416"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24.0dip"
                        android:layout_marginEnd="30.0dip"
                        android:layout_weight="1.0"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Pressure Enthalpy Calculator"
                        android:textColor="#ff444444"
                        android:textSize="16.0sp" />

                    <ImageView
                        android:id="@id/imageView1216"
                        android:layout_width="9.0dip"
                        android:layout_height="16.0dip"
                        android:layout_marginEnd="13.0dip"
                        app:srcCompat="@drawable/right_arrow" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@id/cv5"
                android:layout_width="fill_parent"
                android:layout_height="100.0dip"
                android:layout_marginBottom="15.0dip"
                app:cardCornerRadius="10.0dip">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@id/textView4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24.0dip"
                        android:layout_marginEnd="30.0dip"
                        android:layout_weight="1.0"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Release Calculator"
                        android:textColor="#ff444444"
                        android:textSize="16.0sp" />

                    <ImageView
                        android:id="@id/imageView12"
                        android:layout_width="9.0dip"
                        android:layout_height="16.0dip"
                        android:layout_marginEnd="13.0dip"
                        app:srcCompat="@drawable/right_arrow" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@id/cv6"
                android:layout_width="fill_parent"
                android:layout_height="100.0dip"
                android:layout_marginBottom="15.0dip"
                app:cardCornerRadius="10.0dip">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@id/textView41"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24.0dip"
                        android:layout_marginEnd="30.0dip"
                        android:layout_weight="1.0"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Superheat-Subcooling Calculator"
                        android:textColor="#ff444444"
                        android:textSize="16.0sp" />

                    <ImageView
                        android:id="@id/imageView121"
                        android:layout_width="9.0dip"
                        android:layout_height="16.0dip"
                        android:layout_marginEnd="13.0dip"
                        app:srcCompat="@drawable/right_arrow" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/loading_overlay" />

</androidx.constraintlayout.widget.ConstraintLayout>
