<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main.calculators.fahrenheit.FahrenheitActivity">
    <ImageView
        android:id="@id/imageView32"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:alpha="0.1"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/backgroud_pipe" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/constraintLayout"
        android:layout_width="fill_parent"
        android:layout_height="75.0dip"
        android:background="#ff2d2f93"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@id/back"
            android:layout_width="23.0dip"
            android:layout_height="32.0dip"
            android:layout_marginStart="10.0dip"
            android:padding="7.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/back" />

        <TextView
            android:id="@id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Saturation Calculator"
            android:textColor="@color/white"
            android:textSize="16.0sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@id/logo"
        android:layout_width="100.0dip"
        android:layout_height="100.0dip"
        android:layout_marginTop="50.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <ScrollView
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginStart="20.0dip"
                android:layout_marginTop="30.0dip"
                android:layout_marginEnd="20.0dip"
                android:layout_marginBottom="30.0dip"
                app:cardBackgroundColor="#ff90cff2"
                app:cardCornerRadius="10.0dip">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@id/textView16"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18.0dip"
                        android:layout_marginEnd="18.0dip"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Get From °F"
                        android:textColor="#ff3638a8"
                        android:textSize="18.0sp"
                        app:layout_constraintBottom_toTopOf="@id/cardView2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.cardview.widget.CardView
                        android:id="@id/cardView2"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="60.0dip"
                        app:cardCornerRadius="10.0dip"
                        app:cardElevation="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="20.0dip"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@id/textView17"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:text="°F"
                                    android:textColor="#ff444444"
                                    android:textSize="12.0sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="40.0dip"
                                android:layout_marginTop="5.0dip"
                                android:background="@drawable/edittext_bg1"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <EditText
                                    android:id="@id/tvF"
                                    android:layout_width="0.0dip"
                                    android:layout_height="fill_parent"
                                    android:layout_weight="1.0"
                                    android:background="@android:color/transparent"
                                    android:ems="10"
                                    android:fontFamily="@font/poppins_medium"
                                    android:imeOptions="actionDone"
                                    android:inputType="numberSigned|numberDecimal"
                                    android:paddingStart="13.0dip"
                                    android:paddingEnd="13.0dip"
                                    android:textColor="#ff2e3094"
                                    android:textSize="12.0sp" />

                                <TextView
                                    android:id="@id/textView19"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="13.0dip"
                                    android:layout_marginEnd="10.0dip"
                                    android:text="(-65° to 125°)"
                                    android:textColor="#ffb8b8b8"
                                    android:textSize="10.0sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15.0dip"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="fill_parent"
                                    android:layout_marginEnd="5.0dip"
                                    android:layout_weight="1.0"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@id/textView20"
                                        android:layout_width="fill_parent"
                                        android:layout_height="0.0dip"
                                        android:layout_weight="1.0"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:gravity="bottom"
                                        android:text="PSIG"
                                        android:textColor="#ff444444"
                                        android:textSize="12.0sp" />

                                    <TextView
                                        android:id="@id/psig"
                                        android:layout_width="fill_parent"
                                        android:layout_height="40.0dip"
                                        android:layout_marginTop="5.0dip"
                                        android:background="@drawable/edittext_bg2"
                                        android:fontFamily="@font/poppins_regular"
                                        android:gravity="center_vertical"
                                        android:paddingStart="13.0dip"
                                        android:paddingEnd="13.0dip"
                                        android:textColor="#ff444444"
                                        android:textSize="12.0sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5.0dip"
                                    android:layout_weight="1.0"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.0"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@id/textView25"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/poppins_semibold"
                                            android:text="Specific Volume\n(CV Liquid)"
                                            android:textColor="#ff444444"
                                            android:textSize="12.0sp" />

                                        <TextView
                                            android:id="@id/textView26"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="end|bottom"
                                            android:layout_weight="1.0"
                                            android:fontFamily="@font/poppins_regular"
                                            android:gravity="end"
                                            android:text="cu.ft./lbs."
                                            android:textColor="#ffa5a5a5"
                                            android:textSize="8.0sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@id/tvCvLiquid"
                                        android:layout_width="fill_parent"
                                        android:layout_height="40.0dip"
                                        android:layout_marginTop="5.0dip"
                                        android:layout_weight="1.0"
                                        android:background="@drawable/edittext_bg2"
                                        android:fontFamily="@font/poppins_regular"
                                        android:gravity="center_vertical"
                                        android:paddingStart="13.0dip"
                                        android:paddingEnd="13.0dip"
                                        android:textColor="#ff444444"
                                        android:textSize="12.0sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15.0dip"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="5.0dip"
                                    android:layout_weight="1.0"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="fill_parent"
                                        android:layout_height="fill_parent"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@id/textView21"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/poppins_semibold"
                                            android:text="Specific Volume\n(CV) Vaper"
                                            android:textColor="#ff444444"
                                            android:textSize="12.0sp" />

                                        <TextView
                                            android:id="@id/textView24"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="end|bottom"
                                            android:layout_weight="1.0"
                                            android:fontFamily="@font/poppins_regular"
                                            android:gravity="end"
                                            android:text="cu.ft./lbs."
                                            android:textColor="#ffa5a5a5"
                                            android:textSize="8.0sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@id/tvCvVaper"
                                        android:layout_width="fill_parent"
                                        android:layout_height="40.0dip"
                                        android:layout_marginTop="5.0dip"
                                        android:background="@drawable/edittext_bg2"
                                        android:fontFamily="@font/poppins_regular"
                                        android:gravity="center_vertical"
                                        android:paddingStart="13.0dip"
                                        android:paddingEnd="13.0dip"
                                        android:textColor="#ff444444"
                                        android:textSize="12.0sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="fill_parent"
                                    android:layout_marginStart="5.0dip"
                                    android:layout_weight="1.0"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="fill_parent"
                                        android:layout_height="fill_parent"
                                        android:layout_weight="1.0"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@id/textView27"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="bottom"
                                            android:fontFamily="@font/poppins_semibold"
                                            android:text="Density Liquid"
                                            android:textColor="#ff444444"
                                            android:textSize="12.0sp" />

                                        <TextView
                                            android:id="@id/textView28"
                                            android:layout_width="0.0dip"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="bottom"
                                            android:layout_weight="1.0"
                                            android:fontFamily="@font/poppins_regular"
                                            android:gravity="end"
                                            android:text="cu.ft./lbs."
                                            android:textColor="#ffa5a5a5"
                                            android:textSize="8.0sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@id/tvDenLiquid"
                                        android:layout_width="fill_parent"
                                        android:layout_height="40.0dip"
                                        android:layout_marginTop="5.0dip"
                                        android:background="@drawable/edittext_bg2"
                                        android:fontFamily="@font/poppins_regular"
                                        android:gravity="center_vertical"
                                        android:paddingStart="13.0dip"
                                        android:paddingEnd="13.0dip"
                                        android:textColor="#ff444444"
                                        android:textSize="12.0sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15.0dip"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="5.0dip"
                                    android:layout_weight="1.0"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="fill_parent"
                                        android:layout_height="fill_parent"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@id/textView22"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1.0"
                                            android:fontFamily="@font/poppins_semibold"
                                            android:text="Density Vaper"
                                            android:textColor="#ff444444"
                                            android:textSize="12.0sp" />

                                        <TextView
                                            android:id="@id/textView23"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1.0"
                                            android:fontFamily="@font/poppins_regular"
                                            android:gravity="end|bottom"
                                            android:text="cu.ft./lbs."
                                            android:textColor="#ffa5a5a5"
                                            android:textSize="8.0sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@id/tvDenVaper"
                                        android:layout_width="fill_parent"
                                        android:layout_height="40.0dip"
                                        android:layout_marginTop="5.0dip"
                                        android:background="@drawable/edittext_bg2"
                                        android:fontFamily="@font/poppins_regular"
                                        android:gravity="center_vertical"
                                        android:paddingStart="13.0dip"
                                        android:paddingEnd="13.0dip"
                                        android:textColor="#ff444444"
                                        android:textSize="12.0sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="fill_parent"
                                    android:layout_marginStart="5.0dip"
                                    android:layout_weight="1.0"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@id/textView29"
                                        android:layout_width="wrap_content"
                                        android:layout_height="0.0dip"
                                        android:layout_weight="1.0"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:gravity="bottom"
                                        android:text="PSIA"
                                        android:textColor="#ff444444"
                                        android:textSize="12.0sp" />

                                    <TextView
                                        android:id="@id/tvPsia"
                                        android:layout_width="fill_parent"
                                        android:layout_height="40.0dip"
                                        android:layout_marginTop="5.0dip"
                                        android:background="@drawable/edittext_bg2"
                                        android:fontFamily="@font/poppins_regular"
                                        android:gravity="center_vertical"
                                        android:paddingStart="13.0dip"
                                        android:paddingEnd="13.0dip"
                                        android:textColor="#ff444444"
                                        android:textSize="12.0sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="45.0dip"
                                android:layout_marginTop="27.0dip"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@id/clear"
                                    android:layout_width="fill_parent"
                                    android:layout_height="fill_parent"
                                    android:layout_marginEnd="5.0dip"
                                    android:layout_weight="1.0"
                                    android:backgroundTint="#ff90cff2"
                                    android:fontFamily="@font/poppins_regular"
                                    android:insetTop="0.0dip"
                                    android:insetBottom="0.0dip"
                                    android:text="Clear"
                                    android:textAllCaps="false"
                                    android:textSize="16.0sp"
                                    app:cornerRadius="5.0dip" />

                                <Button
                                    android:id="@id/go_home"
                                    android:layout_width="fill_parent"
                                    android:layout_height="fill_parent"
                                    android:layout_marginStart="5.0dip"
                                    android:layout_weight="1.0"
                                    android:fontFamily="@font/poppins_regular"
                                    android:insetTop="0.0dip"
                                    android:insetBottom="0.0dip"
                                    android:text="Calculate"
                                    android:textAllCaps="false"
                                    android:textSize="16.0sp"
                                    app:cornerRadius="5.0dip"
                                    android:backgroundTint="#ff2d2f93"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>