<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="200.0dip"
    tools:context=".main.magneticTool.BottomSheet">
    <TextView
        android:id="@id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.0dip"
        android:fontFamily="@font/poppins_semibold"
        android:text="DC Threshold: 400 µT"
        android:textColor="#ff444444"
        android:textSize="17.0sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <SeekBar
        android:id="@id/seekBar"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginStart="8.0dip"
        android:layout_marginEnd="8.0dip"
        app:layout_constraintBottom_toTopOf="@id/textView36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/info"
        android:max="2000"/>

    <TextView
        android:id="@id/textView35"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20.0dip"
        android:layout_marginBottom="15.0dip"
        android:fontFamily="@font/poppins_regular"
        android:text="2000 µT"
        android:textColor="#ff444444"
        app:layout_constraintBottom_toTopOf="@id/cardView5"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@id/textView36"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15.0dip"
        android:fontFamily="@font/poppins_regular"
        android:text="1 µT"
        android:textColor="#ff444444"
        app:layout_constraintBottom_toTopOf="@id/cardView5"
        app:layout_constraintStart_toStartOf="@id/cardView5" />

    <androidx.cardview.widget.CardView
        android:id="@id/cardView6"
        android:layout_width="100.0dip"
        android:layout_height="40.0dip"
        android:layout_marginEnd="20.0dip"
        android:layout_marginBottom="30.0dip"
        app:cardBackgroundColor="#ffc6c6c8"
        app:cardCornerRadius="10.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@id/done"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="DONE"
            android:textSize="15.0sp" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@id/cardView5"
        android:layout_width="150.0dip"
        android:layout_height="40.0dip"
        android:layout_marginStart="20.0dip"
        android:layout_marginBottom="30.0dip"
        app:cardBackgroundColor="#ffc6c6c8"
        app:cardCornerRadius="10.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@id/minus"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="-"
                android:textSize="20.0sp" />

            <View
                android:id="@id/view3"
                android:layout_width="1.0dip"
                android:layout_height="wrap_content"
                android:background="@color/black" />

            <TextView
                android:id="@id/plus"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="+"
                android:textSize="20.0sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>